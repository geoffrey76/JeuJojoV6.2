# Copie ce fichier en .env (jamais dans Git) pour le développement local.
# Sur Render, ces valeurs se saisissent dans Environment.

# MongoDB Atlas
MONGODB_USERNAME= 
MONGODB_PASSWORD=
# (ou bien l'adresse complète à la place des deux lignes ci-dessus)
# MONGODB_URI=

# Formulaire de contact (Resend : https://resend.com)
RESEND_API_KEY=
# Adresse qui reçoit les messages. Avec l'expéditeur de test de Resend,
# ce doit être l'adresse du compte Resend.
USER_MAIL=
# Optionnel : expéditeur personnalisé (nécessite un domaine vérifié chez Resend)
# MAIL_FROM=Jeux de JoJo <contact@mondomaine.fr>
